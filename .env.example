# Never commit real secrets.
APP_ENV=development
BIND_ADDR=0.0.0.0:8080
LOG_LEVEL=info

# Future integration endpoints. Keep secrets outside Git.
PROXMOX_URL=https://proxmox.example.invalid:8006
PROXMOX_TOKEN_ID=change-me
PROXMOX_TOKEN_SECRET=change-me

DOCKER_SOCKET=/var/run/docker.sock

# Database is intentionally optional in MVP.
DATABASE_URL=sqlite://data/homelab.db
